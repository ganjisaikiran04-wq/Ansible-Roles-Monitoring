global:
  scrape_interval: 15s
  evaluation_interval: 15s

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - "localhost:9093"

rule_files:
  - "alert.rules.yml"

scrape_configs:

  - job_name: "prometheus"
    static_configs:
      - targets:
          - "localhost:9100"

  - job_name: "node-exporter"
    static_configs:
      - targets:
          - "172.31.89.80:9100"
          - "172.31.15.128:9100"
